# ──────────────────────────────────────────────
# 建景规规范知识问答助手 · 后端环境变量模板
# 使用方式：
#   cp .env.example .env
#   然后把下方占位值替换为真实 key
#
# ⚠️ 严禁在本文件填入真实 key！本文件会被提交到公开仓库
# ──────────────────────────────────────────────

# ── LLM（主：DeepSeek，CLAUDE.md 锁定，不可换 GPT-4/Claude）──
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── LLM 备用：通义千问 Max ──（可空，仅切换备用时填）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

# ── 向量库：Qdrant ──
# 开发期（默认）：留空走本地文件嵌入模式，数据落在 QDRANT_LOCAL_PATH
# 上线/团队协作：填 Docker 服务地址 http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=specs_v1
QDRANT_LOCAL_PATH=./data/qdrant_local

# ── 元数据库：SQLite（不用 ORM，裸 sqlite3）──
SQLITE_PATH=./data/metadata.db

# ── 日志 ──
LOG_LEVEL=INFO

# ── 前端跨域允许的源 ──
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
